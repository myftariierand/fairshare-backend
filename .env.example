# Copy to .env and fill in your own values. Never commit real values to this file.
# Generate each secret separately with: openssl rand -hex 64

# Database configuration
POSTGRES_DB=fairshare                   # The name of the PostgreSQL database
POSTGRES_USER=fairshare                 # The PostgreSQL user
POSTGRES_PASSWORD=                      # The password for the PostgreSQL user

# Database connection string (docker-compose publishes PostgreSQL on port 5433)
DATABASE_URL=postgresql://fairshare:<POSTGRES_PASSWORD>@localhost:5433/fairshare

# Server configuration
PORT=3000                               # The port your backend server will run on
NODE_ENV=development                    # Use production in production

# Authentication secrets
ACCESS_TOKEN_SECRET=                    # Secret key for signing access tokens
RESET_PASSWORD_SECRET=                  # Secret key for signing password reset tokens

# Where new sign-up and bug report notices go. Leave empty to turn them off.
NOTIFICATION_EMAIL=

# Shown in the account-deleted email as a contact address. Leave empty to leave that line out.
SUPPORT_EMAIL=

# Where the welcome email's optional donation button goes. Leave empty to leave that section out.
DONATION_URL=

# Allowed client origins
CLIENT_ORIGIN=http://localhost:5173     # Frontend application (Vite default port)
ADMIN_ORIGIN=                           # Admin dashboard
MOBILE_ORIGIN=                          # Mobile app

# Google sign-in
GOOGLE_CLIENT_ID=                       # Must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in the mobile app
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_WEB_CLIENT_ID=                   # Optional: only if the mobile app uses a different client

# Email (Resend)
RESEND_API_KEY=

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
