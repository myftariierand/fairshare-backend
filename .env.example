# Copy to .env and fill in your own values. Never commit real values to this file.
# The app refuses to start if anything in section 1 is missing or empty, or a secret is shorter than 32 characters.
# Generate each secret separately with: openssl rand -hex 64, and never reuse local secrets in production.

# =====================================================================
# 1. Needed everywhere, including production
#    "Production:" notes what must differ from the local value
# =====================================================================

# Production: the hosted database's connection string
DATABASE_URL=postgresql://fairshare:<POSTGRES_PASSWORD>@localhost:5433/fairshare

# Production: production, which switches to JSON logs
NODE_ENV=development

# Production: new secrets, at least 32 characters each
ACCESS_TOKEN_SECRET=                    # Signs access tokens
RESET_PASSWORD_SECRET=                  # Signs password reset tokens and codes

# Production: the deployed frontend URL. Allowed by CORS and used for links in emails.
CLIENT_ORIGIN=http://localhost:5173

# Google sign-in
# Production: the deployed backend URL + /auth/google/callback, also added to the Google client's redirect URIs
GOOGLE_CLIENT_ID=                       # Must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in the mobile app
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email (Resend). Production: a key for a verified sending domain
RESEND_API_KEY=

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =====================================================================
# 2. Local development only, not needed in production
# =====================================================================

# Only read by docker-compose to create the local database
POSTGRES_DB=fairshare
POSTGRES_USER=fairshare
POSTGRES_PASSWORD=

# Defaults to 3000. Hosts like Vercel set their own.
PORT=3000

# =====================================================================
# 3. Optional in every environment. Leave empty to turn that part off.
# =====================================================================

# Production: set ADMIN_ORIGIN if the admin dashboard is deployed, or it can't call the API
ADMIN_ORIGIN=                           # Admin dashboard URL, allowed by CORS
MOBILE_ORIGIN=                          # Mobile app origin, allowed by CORS

GOOGLE_WEB_CLIENT_ID=                   # Only if the mobile app uses a different Google client

NOTIFICATION_EMAIL=                     # Where new sign-up and bug report notices go
SUPPORT_EMAIL=                          # Contact address shown in the account-deleted email
DONATION_URL=                           # Where the welcome email's donation button goes
