# Copy to .env and fill in your own values. Never commit real values to this file.
# The app refuses to start if a [required] value is missing or empty, or a secret is shorter than 32 characters.
# Generate each secret separately with: openssl rand -hex 64

# Database (POSTGRES_* are only read by docker-compose to create the local database)
POSTGRES_DB=fairshare                   # The name of the PostgreSQL database
POSTGRES_USER=fairshare                 # The PostgreSQL user
POSTGRES_PASSWORD=                      # The password for the PostgreSQL user

# [required] Connection string (docker-compose publishes PostgreSQL on port 5433)
DATABASE_URL=postgresql://fairshare:<POSTGRES_PASSWORD>@localhost:5433/fairshare

# Server
PORT=3000                               # Optional, defaults to 3000
NODE_ENV=development                    # Use production in production (switches to JSON logs)

# [required] Authentication secrets, at least 32 characters each
ACCESS_TOKEN_SECRET=                    # Signs access tokens
RESET_PASSWORD_SECRET=                  # Signs password reset tokens and codes

# Allowed client origins (CORS)
CLIENT_ORIGIN=http://localhost:5173     # [required] Frontend application, also used for links in emails
ADMIN_ORIGIN=                           # Optional: admin dashboard
MOBILE_ORIGIN=                          # Optional: mobile app

# [required] Google sign-in
GOOGLE_CLIENT_ID=                       # Must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in the mobile app
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_WEB_CLIENT_ID=                   # Optional: only if the mobile app uses a different client

# [required] Email (Resend)
RESEND_API_KEY=

# [required] Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email extras. Leave any of these empty to turn that part off.
NOTIFICATION_EMAIL=                     # Where new sign-up and bug report notices go
SUPPORT_EMAIL=                          # Contact address shown in the account-deleted email
DONATION_URL=                           # Where the welcome email's donation button goes
