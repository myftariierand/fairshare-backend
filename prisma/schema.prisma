generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  password             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  friendshipsReceiver  Friendships[]         @relation("FriendshipReceiver")
  friendshipsSender    Friendships[]         @relation("FriendshipSender")
  groups               Group[]               @relation("GroupCreatedBy")
  invitationReceiver   GroupInvitation[]     @relation("GroupInvitationReceiver")
  invitationSender     GroupInvitation[]     @relation("GroupInvitationSender")
  memberships          GroupMember[]
  createdTransactions  Transaction[]         @relation("CreatedBy")
  paidTransactions     Transaction[]         @relation("PaidBy")
  transactionSplits    TransactionSplit[]
  activityLog          ActivityLog[]
  targetActivityLog    ActivityLog[]         @relation("TargetUser")
  emailVerified        Boolean               @default(false)
  emailVerificationOtp EmailVerificationOtp?
  provider             String                @default("local")
  role                 Role                  @default(USER)
  tasks                Task[]
  deviceTokens         DeviceToken[]
}

model Group {
  id             String            @id @default(uuid())
  name           String
  currency       String
  cover          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String
  createdBy      User              @relation("GroupCreatedBy", fields: [createdById], references: [id])
  invitations    GroupInvitation[]
  members        GroupMember[]
  transactions   Transaction[]
  activityLog    ActivityLog[]
  remainingDebts Int               @default(0)
  tasks          Task[]
}

model GroupMember {
  id       String   @id @default(uuid())
  joinedAt DateTime @default(now())
  groupId  String
  userId   String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model GroupInvitation {
  id         String           @id @default(uuid())
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  groupId    String
  senderId   String
  receiverId String
  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  receiver   User             @relation("GroupInvitationReceiver", fields: [receiverId], references: [id])
  sender     User             @relation("GroupInvitationSender", fields: [senderId], references: [id])

  @@unique([groupId, receiverId])
}

model Transaction {
  id          String               @id @default(uuid())
  amount      Decimal              @db.Decimal(10, 2)
  description String
  type        TransactionType      @default(EXPENSE)
  category    TransactionCategory? @default(OTHER)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  groupId     String
  paidById    String
  createdById String
  createdBy   User                 @relation("CreatedBy", fields: [createdById], references: [id])
  group       Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy      User                 @relation("PaidBy", fields: [paidById], references: [id])
  splits      TransactionSplit[]
  activityLog ActivityLog[]
}

model TransactionSplit {
  id            String      @id @default(uuid())
  amount        Decimal     @db.Decimal(10, 2)
  userId        String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, transactionId])
}

model Friendships {
  id         String           @id @default(uuid())
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  senderId   String
  receiverId String
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id])
  sender     User             @relation("FriendshipSender", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
}

model ActivityLog {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  action        ActivityAction
  snapshot      Json?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  groupId       String?
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  targetUserId  String?
  targetUser    User?          @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([groupId])
  @@index([transactionId])
  @@index([targetUserId])
}

model Task {
  id          String   @id @default(uuid())
  text        String
  done        Boolean  @default(false)
  position    Int
  groupId     String
  createdById String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TransactionType {
  EXPENSE
  SETTLEMENT
}

enum ActivityAction {
  USER_REGISTERED
  USER_UPDATED_PROFILE
  USER_CHANGED_PASSWORD
  USER_EMAIL_VERIFIED
  FRIENDSHIP_REQUEST_SENT
  FRIENDSHIP_REQUEST_ACCEPTED
  FRIENDSHIP_REQUEST_REJECTED
  FRIENDSHIP_REQUEST_CANCELLED
  FRIENDSHIP_REMOVED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  GROUP_MEMBER_JOINED
  GROUP_MEMBER_LEFT
  GROUP_MEMBER_REMOVED
  GROUP_INVITATION_SENT
  GROUP_INVITATION_ACCEPTED
  GROUP_INVITATION_REJECTED
  TRANSACTION_CREATED
  TRANSACTION_UPDATED
  TRANSACTION_DELETED
  TRANSACTION_SETTLED
}

model BugReport {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    Severity @default(MINOR)

  name   String?
  email  String?
  device String?

  status BugStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationOtp {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Severity {
  CRITICAL
  MAJOR
  MINOR
  COSMETIC
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TransactionCategory {
  DRINKS
  FOOD
  GROCERIES
  ACCOMMODATION
  TRANSPORTATION
  COFFEE
  FEES
  ENTERTAINMENT
  SHOPPING
  OTHER
  SUBSCRIPTIONS
  EDUCATION
  SPORTS
  PETS
  GIFTS
  TRAVEL
  HEALTH
  TAXES
  MAINTENANCE
  INSURANCE
  CHILDCARE
  WORK
  DONATIONS
  PERSONAL_CARE
  UTILITIES
}

enum Role {
  USER
  ADMIN
}

model DeviceToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
