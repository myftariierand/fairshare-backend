generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  password            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  friendshipsReceiver Friendships[]      @relation("FriendshipReceiver")
  friendshipsSender   Friendships[]      @relation("FriendshipSender")
  groups              Group[]            @relation("GroupCreatedBy")
  invitationReceiver  GroupInvitation[]  @relation("GroupInvitationReceiver")
  invitationSender    GroupInvitation[]  @relation("GroupInvitationSender")
  memberships         GroupMember[]
  createdTransactions Transaction[]      @relation("CreatedBy")
  paidTransactions    Transaction[]      @relation("PaidBy")
  transactionSplits   TransactionSplit[]
  activityLog         ActivityLog[]
  targetActivityLog   ActivityLog[]      @relation("TargetUser")
}

model Group {
  id           String            @id @default(uuid())
  name         String
  currency     String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  createdById  String
  createdBy    User              @relation("GroupCreatedBy", fields: [createdById], references: [id])
  invitations  GroupInvitation[]
  members      GroupMember[]
  transactions Transaction[]
  activityLog  ActivityLog[]
}

model GroupMember {
  id       String   @id @default(uuid())
  joinedAt DateTime @default(now())
  groupId  String
  userId   String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model GroupInvitation {
  id         String           @id @default(uuid())
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  groupId    String
  senderId   String
  receiverId String
  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  receiver   User             @relation("GroupInvitationReceiver", fields: [receiverId], references: [id])
  sender     User             @relation("GroupInvitationSender", fields: [senderId], references: [id])

  @@unique([groupId, receiverId])
}

model Transaction {
  id          String             @id @default(uuid())
  amount      Float
  description String
  type        TransactionType    @default(EXPENSE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  groupId     String
  paidById    String
  createdById String
  createdBy   User               @relation("CreatedBy", fields: [createdById], references: [id])
  group       Group              @relation(fields: [groupId], references: [id])
  paidBy      User               @relation("PaidBy", fields: [paidById], references: [id])
  splits      TransactionSplit[]
  activityLog ActivityLog[]
}

model TransactionSplit {
  id            String      @id @default(uuid())
  amount        Float
  userId        String
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, transactionId])
}

model Friendships {
  id         String           @id @default(uuid())
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  senderId   String
  receiverId String
  receiver   User             @relation("FriendshipReceiver", fields: [receiverId], references: [id])
  sender     User             @relation("FriendshipSender", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
}

model ActivityLog {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  action        ActivityAction
  snapshot      Json?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  groupId       String?
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  targetUserId  String?
  targetUser    User?          @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([groupId])
  @@index([transactionId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TransactionType {
  EXPENSE
  SETTLEMENT
}

enum ActivityAction {
  USER_REGISTERED
  USER_UPDATED_PROFILE
  USER_CHANGED_PASSWORD
  FRIENDSHIP_REQUEST_SENT
  FRIENDSHIP_REQUEST_ACCEPTED
  FRIENDSHIP_REQUEST_REJECTED
  FRIENDSHIP_REQUEST_CANCELLED
  // FRIENDSHIP_REQUEST_RECEIVED
  FRIENDSHIP_REMOVED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  GROUP_MEMBER_JOINED
  GROUP_MEMBER_LEFT
  GROUP_MEMBER_REMOVED
  GROUP_INVITATION_SENT
  GROUP_INVITATION_ACCEPTED
  GROUP_INVITATION_REJECTED
  // GROUP_INVITATION_RECEIVED
  TRANSACTION_CREATED
  TRANSACTION_UPDATED
  TRANSACTION_DELETED
  TRANSACTION_SETTLED
}
