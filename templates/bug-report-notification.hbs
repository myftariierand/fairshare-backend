<html>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>New Bug Report</title>
    <link
      href='https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@700;800&family=DM+Sans:wght@400;500&display=swap'
      rel='stylesheet'
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'DM Sans', sans-serif; background-color: #0d0d10;
      background-image: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(220,
      38, 38, 0.12) 0%, transparent 70%), repeating-linear-gradient(0deg,
      transparent, transparent 39px, rgba(255,255,255,0.025) 40px),
      repeating-linear-gradient(90deg, transparent, transparent 39px,
      rgba(255,255,255,0.025) 40px); min-height: 100vh; padding: 40px 20px; }
      .container { max-width: 580px; margin: auto; background: #18181c;
      border-radius: 2px; overflow: hidden; border: 1px solid
      rgba(255,255,255,0.07); box-shadow: 0 0 0 1px rgba(220, 38, 38, 0.15), 0
      32px 64px rgba(0,0,0,0.6), 0 0 80px rgba(220, 38, 38, 0.06); } /* ──
      Header ── */ .header { background: #dc2626; background-image:
      linear-gradient(135deg, #dc2626 0%, #991b1b 100%); padding: 28px 32px;
      position: relative; overflow: hidden; } .header::before { content: 'BUG';
      position: absolute; right: -8px; top: -14px; font-family: 'Syne',
      sans-serif; font-weight: 800; font-size: 96px; color:
      rgba(255,255,255,0.06); letter-spacing: -4px; user-select: none;
      pointer-events: none; } .header-eyebrow { font-family: 'DM Mono',
      monospace; font-size: 10px; font-weight: 500; letter-spacing: 0.2em;
      text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom:
      8px; } .header-title { font-family: 'Syne', sans-serif; font-weight: 800;
      font-size: 22px; color: #ffffff; letter-spacing: -0.3px; display: flex;
      align-items: center; gap: 10px; } .header-icon { font-size: 20px;
      line-height: 1; } /* ── Severity Banner ── */ .severity-bar { padding:
      12px 32px; background: rgba(220, 38, 38, 0.08); border-bottom: 1px solid
      rgba(220, 38, 38, 0.15); display: flex; align-items: center; gap: 12px; }
      .severity-label { font-family: 'DM Mono', monospace; font-size: 10px;
      font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase;
      color: rgba(255,255,255,0.35); } .badge { display: inline-flex;
      align-items: center; gap: 5px; padding: 3px 10px 3px 8px; border-radius:
      2px; font-family: 'DM Mono', monospace; font-size: 11px; font-weight: 500;
      letter-spacing: 0.08em; text-transform: uppercase; background: #dc2626;
      color: #fff; } .badge::before { content: '●'; font-size: 7px; color:
      rgba(255,255,255,0.7); } /* ── Body ── */ .body { padding: 28px 32px 24px;
      } .field { margin-bottom: 24px; } .field:last-of-type { margin-bottom: 0;
      } .field-label { font-family: 'DM Mono', monospace; font-size: 10px;
      font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.3); margin-bottom: 8px; display: flex;
      align-items: center; gap: 8px; } .field-label::after { content: ''; flex:
      1; height: 1px; background: rgba(255,255,255,0.06); } .field-content {
      font-size: 14px; line-height: 1.65; color: rgba(255,255,255,0.85);
      background: rgba(255,255,255,0.04); border: 1px solid
      rgba(255,255,255,0.07); border-radius: 2px; padding: 12px 14px;
      white-space: pre-wrap; word-break: break-word; font-family: 'DM Sans',
      sans-serif; } .field-content.mono { font-family: 'DM Mono', monospace;
      font-size: 13px; color: rgba(255,255,255,0.7); } /* ── Divider ── */
      .divider { border: none; border-top: 1px solid rgba(255,255,255,0.06);
      margin: 28px 0; } /* ── Meta Row ── */ .meta-row { display: flex;
      align-items: center; justify-content: space-between; gap: 16px; flex-wrap:
      wrap; } .meta-item { display: flex; align-items: center; gap: 8px; }
      .meta-dot { width: 6px; height: 6px; border-radius: 50%; background:
      #dc2626; flex-shrink: 0; box-shadow: 0 0 6px rgba(220,38,38,0.6); }
      .meta-text { font-family: 'DM Mono', monospace; font-size: 11px; color:
      rgba(255,255,255,0.3); } .meta-text strong { color: rgba(255,255,255,0.5);
      font-weight: 500; } /* ── Footer ── */ .footer { padding: 14px 32px;
      background: rgba(0,0,0,0.25); border-top: 1px solid
      rgba(255,255,255,0.05); display: flex; align-items: center;
      justify-content: space-between; gap: 16px; } .footer-brand { font-family:
      'Syne', sans-serif; font-size: 11px; font-weight: 700; letter-spacing:
      0.12em; text-transform: uppercase; color: rgba(255,255,255,0.15); }
      .footer-timestamp { font-family: 'DM Mono', monospace; font-size: 10px;
      color: rgba(255,255,255,0.2); } /* ── Mobile ── */ @media (max-width:
      480px) { body { padding: 0; background-image: radial-gradient(ellipse 80%
      40% at 50% -5%, rgba(220, 38, 38, 0.12) 0%, transparent 70%); } .container
      { border-radius: 0; border-left: none; border-right: none; box-shadow:
      none; } .header { padding: 22px 20px; } .header::before { font-size: 72px;
      top: -10px; right: -4px; } .header-eyebrow { font-size: 9px;
      letter-spacing: 0.15em; } .header-title { font-size: 18px; } .severity-bar
      { padding: 10px 20px; } .body { padding: 20px 20px 18px; } .field {
      margin-bottom: 20px; } .field-content { font-size: 13px; padding: 10px
      12px; } .field-content.mono { font-size: 12px; overflow-x: auto;
      white-space: pre; } .divider { margin: 20px 0; } .meta-row {
      flex-direction: column; align-items: flex-start; gap: 10px; } .footer {
      padding: 12px 20px; flex-direction: column; align-items: flex-start; gap:
      4px; } }
    </style>
  </head>

  <body>
    <div class='container'>

      <div class='header'>
        <div class='header-eyebrow'>Issue Tracker · Automated Report</div>
        <div class='header-title'>
          <span class='header-icon'>⚠</span>
          New Bug Report Submitted
        </div>
      </div>

      <div class='severity-bar'>
        <span class='severity-label'>Severity</span>
        <span class='badge'>{{severity}}</span>
      </div>

      <div class='body'>

        <div class='field'>
          <div class='field-label'>Title</div>
          <div class='field-content'>{{title}}</div>
        </div>

        <div class='field'>
          <div class='field-label'>Description</div>
          <div class='field-content'>{{description}}</div>
        </div>

        {{#if device}}
          <div class='field'>
            <div class='field-label'>Device Info</div>
            <div class='field-content mono'>{{device}}</div>
          </div>
        {{/if}}

        <hr class='divider' />

        <div class='meta-row'>
          {{#if name}}
            <div class='meta-item'>
              <div class='meta-dot'></div>
              <div class='meta-text'>Reported by <strong>{{name}}</strong></div>
            </div>
          {{/if}}

          {{#if email}}
            <div class='meta-item'>
              <div class='meta-dot'></div>
              <div class='meta-text'><strong>{{email}}</strong></div>
            </div>
          {{/if}}
        </div>

      </div>

      <div class='footer'>
        <div class='footer-brand'>Bug Tracker</div>
        <div class='footer-timestamp'>Submitted at {{createdAt}}</div>
      </div>

    </div>
  </body>
</html>