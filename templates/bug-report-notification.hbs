{{> pill text=severity}}
{{#> heading}}{{title}}{{/heading}}
{{> block label='Description' value=description}}
{{#if device}}
  {{> block label='Device' value=device mono=true}}
{{/if}}
{{#> facts}}
  {{#if name}}
    {{> fact label='Reported by' value=name}}
  {{/if}}
  {{#if email}}
    {{> fact label='Email' value=email}}
  {{/if}}
  {{#unless name}}
    {{#unless email}}
      {{> fact label='Reported by' value='Anonymous'}}
    {{/unless}}
  {{/unless}}
  {{> fact label='Submitted' value=submittedOn}}
{{/facts}}
