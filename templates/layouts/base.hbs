<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>{{subject}}</title>
    <style>
      @media (prefers-color-scheme: dark) {
        .x-bg { background-color: #0d0e10 !important; }
        .x-card { background-color: #16181b !important; border-color: #2a2d32 !important; }
        .x-text { color: #f3f4f1 !important; }
        .x-muted { color: #a2a7ae !important; }
        .x-line { border-color: #2a2d32 !important; }
        .x-sub { background-color: #1e2125 !important; }
        .x-btn { background-color: #c8f169 !important; }
        .x-btnt { color: #121405 !important; }
        .x-link { color: #c8f169 !important; }
        .x-owe { color: #ffa26b !important; }
        .x-bad { color: #ff8a7a !important; }
        .x-t1 { background-color: #2b3a1e !important; color: #c8f169 !important; }
      }
    </style>
  </head>
  <body style="margin:0;padding:0">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0">{{preheader}}</div>
    <table class="x-bg" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#fafaf7" style="background-color:#fafaf7">
      <tr>
        <td align="center" style="padding:24px 16px 32px">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px">
            <tr>
              <td style="padding:0 4px 16px">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td valign="middle" width="44">
                      <img src="{{appUrl}}/email/logo-64.png" width="32" height="32" alt="" style="display:block;border:0;border-radius:9px" />
                    </td>
                    <td class="x-text" valign="middle" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:22px;font-weight:600;letter-spacing:-.2px;color:#15171a">FairShare</td>
                    {{#if internal}}
                      <td align="right" valign="middle">
                        <span class="x-sub x-muted" style="display:inline-block;background-color:#f0f0ec;border-radius:99px;padding:3px 10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;font-weight:500;color:#5f646b">Internal</span>
                      </td>
                    {{/if}}
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="x-card" bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #e2e3de;border-radius:20px;padding:28px 24px 12px">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  {{{body}}}
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 4px 0">
                <p class="x-muted" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#5f646b">{{footer}}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
