<html>
  <head>
    <style>
      body { background: #f8fafc; font-family: 'Inter', Arial, sans-serif;
      color: #0f172a; margin: 0; padding: 0; } .container { max-width: 420px;
      margin: 40px auto; background: #fff; border: 1px solid #e5e7eb;
      border-radius: 12px; box-shadow: 0 2px 8px rgba(16, 24, 40, 0.05);
      padding: 32px 24px; } h2 { font-size: 1.5rem; font-weight: 600;
      margin-bottom: 16px; color: #0f172a; letter-spacing: -0.5px; } p {
      font-size: 1rem; margin-bottom: 18px; color: #334155; } .btn { display:
      inline-block; padding: 12px 24px; background-color: #18181b; color: #fff;
      text-decoration: none; border-radius: 8px; font-weight: 500; font-size:
      1rem; box-shadow: 0 1px 2px rgba(16, 24, 40, 0.05); transition: background
      0.2s; } .btn:hover { background-color: #27272a; } .footer { margin-top:
      24px; font-size: 0.95rem; color: #64748b; text-align: center; }
    </style>
  </head>
  <body>
    <div class='container'>
      <h2>Password Reset Request</h2>
      <p>Hello from FairShare,</p>
      <p>You recently requested to reset your password. Click the button below
        to reset it:</p>
      <p style='text-align:center;'>
        <a class='btn' href='{{resetUrl}}'>Reset Your Password</a>
      </p>
      <div class='footer'>
        This link is valid for 1 hour.<br />
        If you didn't request this, you can ignore this email.
      </div>
    </div>
  </body>
</html>