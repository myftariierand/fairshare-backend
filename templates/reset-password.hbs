{{#if hasPassword}}
  {{#> heading}}Reset your password{{/heading}}
  {{#> p}}We got a request to reset the password for {{email}}.{{/p}}
  {{> button label='Reset password' url=resetUrl}}
  {{#> p}}This link works once, for 1 hour.{{/p}}
  {{#> small}}Didn’t ask for this? You can ignore this email. Your password stays the same.{{/small}}
{{else}}
  {{#> heading}}Set a password{{/heading}}
  {{#> p}}{{email}} signs in with Google and has no password yet. Set one and you can sign in either way.{{/p}}
  {{> button label='Set password' url=resetUrl}}
  {{#> p}}This link works once, for 1 hour.{{/p}}
  {{#> small}}Didn’t ask for this? You can ignore this email. Nothing changes.{{/small}}
{{/if}}
{{> link-fallback url=resetUrl}}
